# Copy to .env; never commit .env or credentials.
# Generate key material using: python scripts/configure_deployment.py
APP_SECRET_KEY=
SESSION_SECRET=
POSTGRES_PASSWORD=
SOURCE_MOUNT=/srv/hospital/discovery-input
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
DATABASE_HOST_ALLOWLIST=
SMB_HOST_ALLOWLIST=
# Set only with approved routed deployment:
# SOURCE_NETWORK=hospital_discovery_sources
# SQLALCHEMY DATABASE_URL is set by compose to the catalog database.
# Source database credentials are registered separately in the application.
