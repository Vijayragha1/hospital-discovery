ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 SPACY_MODEL=en_core_web_lg \
    HOME=/tmp XDG_CACHE_HOME=/tmp/cache
WORKDIR /app/backend
COPY backend/requirements.txt backend/requirements-ml.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-ml.txt \
    && pip install --no-cache-dir https://github.com/explosion/spacy-models/releases/download/en_core_web_lg-3.8.0/en_core_web_lg-3.8.0-py3-none-any.whl \
    && python -c "import spacy; spacy.load('en_core_web_lg')" \
    && pip check
COPY backend/ ./
COPY scripts/ /app/scripts/
COPY fixtures/ /app/fixtures/
RUN python /app/scripts/patch_python_tds.py \
    && mkdir -p /data /sources && chown -R 10001:10001 /data /sources /app
USER 10001:10001
EXPOSE 8765
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8765", "--no-access-log"]
