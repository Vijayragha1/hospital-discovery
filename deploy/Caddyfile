{
	auto_https off
	admin off
}
:8443 {
	tls /certs/server.crt /certs/server.key
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Cache-Control no-store
		Content-Security-Policy "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
	handle /api/* {
		request_body {
			max_size 64KB
		}
		import /run/ingress/upstream.caddy
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
